# Copier en infra/.env (non versionné) et remplacer le mot de passe.
POSTGRES_DB=safetradev2
POSTGRES_USER=safetradev2
POSTGRES_PASSWORD=change-me

# Ports publiés sur la machine hôte (127.0.0.1 uniquement). Choisis libres et
# distincts de ceux des autres projets du poste (6379 Memurai, 8000 ancien
# SafeTrade, 5433, 55432 et 55433 autres bases). Vérifier avant tout changement :
#   netstat -ano | findstr LISTENING
#   docker ps -a --format "{{.Names}} {{.Ports}}"
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
API_HOST_PORT=18000
WEB_HOST_PORT=13000
