# Copier en infra/.env (non versionné) et remplacer le mot de passe.
POSTGRES_DB=safetradev2
POSTGRES_USER=safetradev2
POSTGRES_PASSWORD=change-me

# Clé AES-256 des secrets au repos (secret TOTP, token Deriv) : 32 octets en base64.
# À générer, ne jamais réutiliser d'un environnement à l'autre :
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SAFETRADE_ENCRYPTION_KEY=

# Deriv : compte de démonstration uniquement, pour les essais de développement.
# App ID de l'application et jeton PAT, jamais dans Git ni dans une conversation.
SAFETRADE_DERIV_APP_ID=
SAFETRADE_DERIV_DEMO_PAT=

# E-mails : relais SMTP Brevo (compte, clé SMTP, expéditeur validé chez Brevo).
# Vide : les e-mails vont au journal du conteneur, en développement seulement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=SafeTrade

# Paiements. Vide : le paiement correspondant reste désactivé.
# Chariow n'a pas de mode de test : toute vente est réelle.
SAFETRADE_CHARIOW_API_KEY=
SAFETRADE_CHARIOW_WEBHOOK_SECRET=
# Identifiants des produits Chariow publiés, de type licence (chaque formule).
SAFETRADE_CHARIOW_PRODUCT_WEEKLY=
SAFETRADE_CHARIOW_PRODUCT_MONTHLY=
SAFETRADE_CHARIOW_PRODUCT_ANNUAL=
# Écart toléré (%) entre le produit converti en USD et le prix de la formule.
SAFETRADE_CHARIOW_PRICE_TOLERANCE_PCT=10
SAFETRADE_NOWPAYMENTS_API_KEY=
SAFETRADE_NOWPAYMENTS_IPN_SECRET=
# Bac à sable NOWPayments : true tant que les vrais paiements ne sont pas autorisés.
SAFETRADE_NOWPAYMENTS_SANDBOX=true

# Ports publiés sur la machine hôte (127.0.0.1 uniquement). Choisis libres et
# distincts de ceux des autres projets du poste (6379 Memurai, 8000 ancien
# SafeTrade, 5433, 55432 et 55433 autres bases). Vérifier avant tout changement :
#   netstat -ano | findstr LISTENING
#   docker ps -a --format "{{.Names}} {{.Ports}}"
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
API_HOST_PORT=18000
WEB_HOST_PORT=13000
