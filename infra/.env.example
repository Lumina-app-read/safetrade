# Copier en infra/.env (non versionné) et remplacer les valeurs.
POSTGRES_DB=safetrade
POSTGRES_USER=safetrade
POSTGRES_PASSWORD=change-me

# Ports publiés sur la machine hôte (127.0.0.1 uniquement), choisis pour éviter
# les conflits avec un PostgreSQL ou un Redis local.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
